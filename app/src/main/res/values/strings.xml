    <string name="tutorial_welcome_title">Welcome to Medication Logger</string>
    <string name="tutorial_welcome_text">It tracks your prescriptions, the boxes you buy and the pills you set out each week. This tour uses sample data; yours stays as it is.</string>
    <string name="tutorial_tabs_title">Tabs</string>
    <string name="tutorial_tabs_text">Prescriptions, Boxes and Refills hold your records. Boxes is where you\'ll be most of the time. Settings holds the reminders.</string>
    <string name="tutorial_prescription_title">Prescriptions</string>
    <string name="tutorial_prescription_text">A card shows a prescription\'s status and repetitions. Order the next repetition, then Buy it to add its boxes.</string>
    <string name="tutorial_add_title">Add new</string>
    <string name="tutorial_add_text">Add a prescription here when you get one.</string>
    <string name="tutorial_box_title">Boxes</string>
    <string name="tutorial_box_text">Each week, Weekly refill takes 7 pills from a box. If they won\'t last until the next refill, Partial refill makes up the rest from another box.</string>
    <string name="tutorial_edit_title">Edit</string>
    <string name="tutorial_edit_text">Hold any card for a second to edit or delete it.</string>
    <string name="tutorial_refills_title">Refills</string>
    <string name="tutorial_refills_text">Every refill is logged here. Partial refills that make up a week are stacked together.</string>
    <string name="tutorial_doses_title">Missed doses</string>
    <string name="tutorial_doses_text">Log a missed or delayed dose when it happens. Below is how many pills are left in your weekly lot.</string>
    <string name="tutorial_pill_time_title">Daily pill</string>
    <string name="tutorial_pill_time_text">What time do you take your pill? Its reminder comes then.</string>
    <string name="tutorial_refill_time_title">Weekly refill</string>
    <string name="tutorial_refill_time_text">When do you set out your pills for the week? The refill reminder comes then.</string>
    <string name="tutorial_done_title">You\'re all set</string>
    <string name="tutorial_done_text">Start by adding your prescription. Help in Settings brings back this tour.</string>
