<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ copies apps to a new device even with allowBackup="false", so everything is left out here too:
     the data is health data, and exports are how it moves -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
